<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <!-- Define properties -->
    <Properties>
        <Property name="basePath">./logs</Property>
    </Properties>

    <!-- Define appenders (where logs will go) -->
    <Appenders>

        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Rolling File Appender -->
        <RollingFile
                name="File"
                fileName="${basePath}/automation.log"
                filePattern="${basePath}/automation-%d{yyyy-MM-dd-HH-mm-ss}.log">

            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <!-- Rotate file when size exceeds 5 MB -->
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
        </RollingFile>

    </Appenders>

    <!-- Define loggers -->
    <Loggers>
        <!-- Root logger controls global log level -->
        <Root level="info">
            <!-- You can enable console logs if needed -->
            <!-- <AppenderRef ref="Console"/> -->
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>

</Configuration>
